{
  "name": "@kithwork/email",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/queue/producer.d.ts",
      "node": {
        "import": "./dist/queue/producer.js"
      }
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "node": {
        "import": "./dist/crypto.js"
      }
    },
    "./worker": {
      "types": "./dist/queue/worker.d.ts",
      "node": {
        "import": "./dist/queue/worker.js"
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean.ts",
    "build": "node scripts/clean.ts && tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --project tsconfig.json",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "bullmq": "6.5.4",
    "ioredis": "6.0.0",
    "nodemailer": "10.3.1",
    "react-email": "6.11.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/html-to-text": "9.0.4",
    "@types/prismjs": "1.26.6",
    "@types/css-tree": "3.2.0",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
