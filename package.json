{
  "name": "kithwork",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.13.0",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "db:generate": "pnpm --filter @kithwork/database db:generate",
    "db:check": "pnpm --filter @kithwork/database db:check",
    "db:migrate": "turbo run build --filter=@kithwork/database && pnpm --filter @kithwork/database db:migrate",
    "dev": "turbo run dev --filter=@kithwork/api... --filter=@kithwork/worker...",
    "env:init": "node scripts/env-init.ts",
    "infra:telemetry": "docker compose --profile telemetry up --wait --wait-timeout 120",
    "build": "turbo run build",
    "check": "pnpm format:check && turbo run build typecheck test:unit test:build && pnpm exec eslint . --max-warnings 0 && pnpm exec tsc --project tsconfig.json && pnpm exec tsc --project tests/tsconfig.json && pnpm test:tooling",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run build && eslint . --max-warnings 0",
    "test": "turbo run test:unit test:build && pnpm test:tooling",
    "test:build": "turbo run test:build",
    "test:unit": "turbo run test:unit",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck && tsc --project tsconfig.json && tsc --project tests/tsconfig.json",
    "infra:up": "docker compose up --wait --wait-timeout 120",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps",
    "infra:logs": "docker compose logs --follow",
    "test:tooling": "pnpm exec turbo run build --filter=@kithwork/database && pnpm exec vitest run --project tooling",
    "test:integration": "pnpm exec turbo run build --filter=@kithwork/api... --filter=@kithwork/worker... && pnpm exec vitest run --project integration",
    "test:integration:coverage": "pnpm test:integration --coverage"
  },
  "devDependencies": {
    "@kithwork/email": "workspace:*",
    "drizzle-kit": "0.31.11",
    "@eslint/js": "10.0.1",
    "@kithwork/database": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "5.1.0",
    "bullmq": "6.5.4",
    "eslint": "10.14.0",
    "ioredis": "6.0.0",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "testcontainers": "12.2.1",
    "turbo": "2.11.10",
    "typescript": "catalog:",
    "typescript-eslint": "8.72.1",
    "vitest": "catalog:",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
