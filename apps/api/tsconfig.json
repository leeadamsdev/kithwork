{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2024", "DOM"],
    // Drizzle's upstream declarations have errors; application source remains strict.
    "skipLibCheck": true,
    "paths": {
      // IITM 3.5.3 publishes .d.ts for its .mjs hook. Remove when upstream ships .d.mts.
      "import-in-the-middle/register-hooks.mjs": [
        "./node_modules/import-in-the-middle/register-hooks.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ]
}
