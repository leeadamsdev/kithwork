{
  "name": "@kithwork/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    "./router": {
      "types": "./dist/trpc/router.d.ts"
    }
  },
  "scripts": {
    "build": "node scripts/clean.ts && tsc --project tsconfig.build.json",
    "clean": "node scripts/clean.ts",
    "dev": "tsx watch --tsconfig ../../tsconfig.base.json --include ../../packages/contracts/dist --include ../../packages/database/dist --include ../../packages/logging/dist --include ../../packages/email/dist src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.client.json",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.17",
    "@fastify/cors": "11.4.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/otel": "0.21.4",
    "@fastify/rate-limit": "11.2.1",
    "@kithwork/contracts": "workspace:*",
    "@kithwork/database": "workspace:*",
    "@kithwork/email": "workspace:*",
    "@kithwork/logging": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-pg": "0.76.0",
    "@opentelemetry/instrumentation-pino": "0.69.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "@trpc/server": "11.23.0",
    "better-auth": "1.7.17",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "import-in-the-middle": "3.5.3",
    "ioredis": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@trpc/client": "11.23.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
