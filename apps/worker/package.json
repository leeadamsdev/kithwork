{
  "name": "@kithwork/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "clean": "node scripts/clean.ts",
    "build": "node scripts/clean.ts && tsc --project tsconfig.build.json",
    "dev": "tsx watch --tsconfig ../../tsconfig.base.json --include ../../packages/contracts/dist --include ../../packages/database/dist --include ../../packages/email/dist --include ../../packages/logging/dist src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --project tsconfig.json",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@kithwork/database": "workspace:*",
    "@kithwork/email": "workspace:*",
    "@kithwork/logging": "workspace:*",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "5.1.0",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
