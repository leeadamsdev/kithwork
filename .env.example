# Development-only credentials; services bind to the loopback interface.
POSTGRES_DB=kithwork
POSTGRES_USER=kithwork
POSTGRES_PASSWORD=kithwork_dev
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_PASSWORD=kithwork_dev

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgresql://kithwork:kithwork_dev@127.0.0.1:5432/kithwork
DATABASE_MAX_CONNECTIONS=10
REDIS_URL=redis://:kithwork_dev@127.0.0.1:6379
API_RATE_LIMIT_MAX=600
API_RATE_LIMIT_NAMESPACE=kithwork:api:rate-limit:
API_AUTH_RATE_LIMIT_MAX=10
AUTH_BASE_URL=http://127.0.0.1:3001
WEB_ORIGIN=http://127.0.0.1:5173
# env:init generates an independent secret for signing authentication cookies.
AUTH_SECRET=

# env:init generates a unique key when creating .env; never commit working keys.
MAIL_ENCRYPTION_KEY=
EMAIL_QUEUE_PREFIX=kithwork
EMAIL_WORKER_CONCURRENCY=2
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
MAIL_FROM="Kithwork <no-reply@kithwork.test>"
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# Enable after starting the optional telemetry Compose profile.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
